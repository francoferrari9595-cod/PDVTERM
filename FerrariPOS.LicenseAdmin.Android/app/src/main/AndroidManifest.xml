<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:theme="@style/Theme.FerrariLicenseAdmin"
        android:label="FerrariPOS Licencias"
        android:icon="@drawable/ferrari_app_icon"
        android:roundIcon="@drawable/ferrari_app_icon"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="true">
        <receiver android:name=".LicenseExpiryReceiver" android:exported="false" />
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
